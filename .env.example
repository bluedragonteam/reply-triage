# Copy to .env and fill in. Never commit .env.

# Required for anything that calls the model (CLI on non-fast-path replies, HTTP server, npm run eval).
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
REPLY_TRIAGE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
REPLY_TRIAGE_EFFORT=low
# "default" enables server-side refusal fallbacks; "off" disables them (they are never sent for Haiku models).
REPLY_TRIAGE_FALLBACKS=default

# HTTP server (npm run serve / npm start)
PORT=8787
HOST=127.0.0.1
